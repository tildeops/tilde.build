# Contact form (fallback email via Resend)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# From address — must be on a verified domain in Resend
RESEND_FROM="tilde <hello@tilde.build>"

# Where contact-form submissions are delivered
RESEND_TO=hello@tilde.build

# Analytics (optional — production defaults are baked into src/lib/site.ts)
# Override per-environment if needed.
NEXT_PUBLIC_GA_ID=G-S15DSE4N46
NEXT_PUBLIC_CLARITY_ID=wyjm95yi3o

# Google Search Console verification token (the value from the "HTML tag"
# method, i.e. the content of <meta name="google-site-verification" ...>).
# Leave empty until the property is created.
GSC_VERIFICATION=
